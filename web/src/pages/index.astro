---
import Base from "../layouts/Base.astro";
import { loadCourse, flattenLessons, coreLessons, loadReviewQuestions, pyodideVersion } from "../lib/course";
import { REPO_URL, url } from "../lib/paths";

const modules = await loadCourse();
const coreModules = modules.filter((m) => !m.optional);
const trackModules = modules.filter((m) => m.optional);
const all = coreLessons(modules);
const trackLessonCount = flattenLessons(trackModules).length;
const first = all[0];
const totalMinutes = all.reduce((sum, l) => sum + l.minutes, 0);
// Packages that browser lessons preload, so the offline download can include them.
const browserPackages = [...new Set(flattenLessons(modules).filter((l) => !l.localOnly).flatMap((l) => l.packages))].sort();
const pyodideBase = `https://cdn.jsdelivr.net/pyodide/v${pyodideVersion()}/full/`;
// Just enough for the home page to count how many review questions are due.
const reviewIndex = JSON.stringify(loadReviewQuestions().map((q) => ({ id: q.id, lesson: q.lesson }))).replace(/</g, "\\u003c");
---

<Base title="Learn Python: free interactive lessons in your browser">
  <section class="hero">
    <h1>Learn Python, for free.</h1>
    <p class="lead">
      Short lessons you can run right here in your browser. Write real code in the first two minutes, get instant
      feedback, and build up one small step at a time. No sign-up and nothing to install.
    </p>
    <p class="cta">
      {first && <a id="start-link" class="button primary large" href={first.href}>Start with lesson 1</a>}
      <a class="button" href={url("fast-track/")}>I already code in another language</a>
      <a class="button" href={url("placement/")}>Already know some Python? Take the placement test</a>
      <a class="button" href={`${REPO_URL}#work-on-your-own-computer`}>Prefer your own computer?</a>
    </p>
    <p>
      <a id="review-link" class="button" href={url("review/")} hidden>Review</a>
    </p>
    <p id="progress-summary" class="muted" aria-live="polite"></p>
  </section>

  <section class="how">
    <h2>How each lesson works</h2>
    <ol class="steps">
      <li><strong>Read</strong> a short explanation with an example.</li>
      <li><strong>Try</strong> it: edit and run code in the built-in editor.</li>
      <li><strong>Check</strong> your answer. Clear hints help when you are stuck.</li>
    </ol>
    <p class="muted">
      Not sure where to start? The <a href={url("placement/")}>placement test</a> takes about five minutes and
      suggests the right lesson. If you already program in another language, the <a href={url("fast-track/")}>fast
      track</a> skips the basics and shows what is different in Python.
    </p>
  </section>

  <section>
    <h2>The course</h2>
    <p class="muted">
      {all.length} lessons in {coreModules.length} modules, about {Math.round(totalMinutes / 60)} hours in total.
      {trackLessonCount > 0 && <span> Plus {trackLessonCount} lessons in optional tracks, below.</span>}
    </p>
    {
      coreModules.map((mod) => (
        <div class="module">
          <h3>
            <span class="module-number">Module {mod.number}</span> {mod.title}
          </h3>
          <p class="muted">{mod.description}</p>
          <ol class="lesson-list">
            {mod.lessons.map((lesson) => (
              <li data-lesson-id={lesson.id}>
                <span class="check" aria-hidden="true" />
                <a href={lesson.href}>{lesson.title}</a>
                <span class="sr-status sr-only" />
                {lesson.localOnly && <span class="badge">own computer</span>}
                <span class="muted minutes">{lesson.minutes} min</span>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </section>

  {
    trackModules.length > 0 && (
      <section id="tracks">
        <h2>Optional tracks</h2>
        <p class="muted">
          Finished the basics (or at least Module 6)? These tracks apply Python to real jobs. They are never required.
          Lessons marked "own computer" need the <a href={`${REPO_URL}#work-on-your-own-computer`}>local track</a>.
        </p>
        {trackModules.map((mod) => (
          <div class="module track" data-track={mod.slug}>
            <h3>{mod.title}</h3>
            <p class="muted">{mod.description}</p>
            <ol class="lesson-list">
              {mod.lessons.map((lesson) => (
                <li data-lesson-id={lesson.id} data-optional="true">
                  <span class="check" aria-hidden="true" />
                  <a href={lesson.href}>{lesson.title}</a>
                  <span class="sr-status sr-only" />
                  {lesson.localOnly && <span class="badge">own computer</span>}
                  <span class="muted minutes">{lesson.minutes} min</span>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </section>
    )
  }

  <section id="offline" class="your-progress" data-pyodide-base={pyodideBase} data-packages={browserPackages.join(",")}>
    <h2>Use it offline</h2>
    <p class="muted">
      Download Python once (about 15 MB) and the course works without a connection. You can also install it as an app
      from your browser's menu.
    </p>
    <p class="row">
      <button id="btn-offline" type="button" class="button">Download for offline</button>
    </p>
    <p id="offline-status" class="notice" role="status" aria-live="polite"></p>
  </section>

  <section class="your-progress">
    <h2>Your progress</h2>
    <p class="muted">
      Progress is saved only in this browser. Download a backup file to move to another device or keep it safe.
    </p>
    <p class="row">
      <button id="btn-export" type="button" class="button">Download progress</button>
      <button id="btn-import" type="button" class="button">Load progress file</button>
      <button id="btn-reset-all" type="button" class="button subtle">Reset progress</button>
      <input id="file-import" type="file" accept="application/json,.json" hidden />
    </p>
    <p id="progress-message" class="notice" role="status" aria-live="polite"></p>
  </section>

  <script id="review-index" type="application/json" set:html={reviewIndex} />
  <script>
    import "../scripts/home-page";
  </script>
</Base>
